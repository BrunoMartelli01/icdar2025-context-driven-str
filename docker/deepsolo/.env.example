# Copy to docker/deepsolo/.env; this file contains no secrets or artifacts.
DEEPSOLO_IMAGE=context-str-deepsolo:m6-qualified-20260818
DEEPSOLO_EXPECTED_IMAGE_ID=sha256:30e0e99d23279060e72b22fe3911a2e42b72de55e70be6349fb06ec37b35755c
DEEPSOLO_CONTAINER=context-str-deepsolo-build

# Absolute physical-host paths. DEEPSOLO_SOURCE_ROOT must be inside the real host
# Git checkout. DEEPSOLO_CHECKPOINT_DIR is used only to create/recover a container;
# the existing qualified snapshot already has /opt/checkpoints. Never commit .env.
DEEPSOLO_SOURCE_ROOT=/absolute/path/to/DeepSolo
DEEPSOLO_CHECKPOINT_DIR=/absolute/path/to/deepsolo-checkpoints

# Used only by scripts/deepsolo_build.sh. A derived image is not qualified
# merely because it builds successfully.
DEEPSOLO_BASE_IMAGE=context-str-deepsolo:m6-qualified-20260818
DEEPSOLO_RECONSTRUCTED_IMAGE=context-str-deepsolo:m6-reconstructed-local

DEEPSOLO_CONTAINER_PYTHON=/opt/context-str-deepsolo/bin/python
DEEPSOLO_CONTAINER_SOURCE=/workspace/DeepSolo
DEEPSOLO_CONTAINER_CHECKPOINT_DIR=/opt/checkpoints
DEEPSOLO_RUNTIME_MANIFEST=docker/deepsolo/runtime_manifest.json
DEEPSOLO_MAIN_PYTHON=.venvs/context-str-main/bin/python
DEEPSOLO_SMOKE_IMAGE=/tmp/context-str-deepsolo-m6-smoke.png
DEEPSOLO_SMOKE_OUTPUT=/tmp/context-str-deepsolo-m6-smoke.json
DEEPSOLO_EXPECTED_DETECTIONS=3
